{
  "name": "job-aggregator-backend",
  "version": "1.0.0",
  "description": "Backend for job listings ingestion & API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "ingest:once": "node -e \"require('./src/services/ingestionService').runIngestion({ source: 'arbeitnow', manual: true }).then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
