# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
# Paste your MongoDB Compass / Atlas connection string here
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/job-aggregator?retryWrites=true&w=majo
# ---- CORS ----
# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI="mongodb+srv://yaseensk2005_db_user:pyOuCdkwfKCacGF6@cluster0.ycjkjae.mongodb.net/"
# ---- Ingestion ----
# How often the scheduler pulls new listings, in minutes
INGESTION_INTERVAL_MINUTES=30
# Public, no-auth job board API used for the live demo (see design doc)
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api
# Identify ourselves honestly to the source instead of spoofing a browser UA
SOURCE_USER_AGENT=job-aggregator-demo/1.0 (+contact: you@example.com)
# Max pages to walk per ingestion run (arbeitnow paginates ~100 jobs/page)
MAX_PAGES_PER_RUN=3
# Delay between paginated requests to the SAME source, in ms (politeness / pacing)
SOURCE_REQUEST_DELAY_MS=1200
# Consecutive-failure threshold before the circuit breaker opens
CIRCUIT_BREAKER_THRESHOLD=3
# How long the circuit stays open before a half-open retry, in ms
CIRCUIT_BREAKER_COOLDOWN_MS=300000

# ---- Manual trigger protection ----
# Simple shared-secret header required to POST /api/ingestion/trigger
INGESTION_TRIGGER_KEY=change-me-please

# ---- Logging ----
LOG_LEVEL=info
